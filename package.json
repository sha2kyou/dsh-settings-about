{
  "name": "dsh-settings-about",
  "version": "0.1.5",
  "description": "dsh Settings → About: runtime version, env, and installed plugin inventory (requires @deepseek-ai/dsh@0.1.1-rc.1)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "collect.js",
    "client.js",
    "cordis.patch.yml",
    "scripts",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sha2kyou/dsh-settings-about.git"
  },
  "bugs": {
    "url": "https://github.com/sha2kyou/dsh-settings-about/issues"
  },
  "homepage": "https://github.com/sha2kyou/dsh-settings-about#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "settings",
    "about"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
